{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    // Off on purpose: every index here is guarded by the reducer's invariant
    // (tab is a question index or the submit tab), so it only buys `!` noise.
    "noUncheckedIndexedAccess": false,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["extensions", "test"]
}
