{
  "name": "pi-question",
  "version": "0.1.0",
  "description": "Ask the user questions mid-run, opencode's v2 question tool ported to pi",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "fmt": "oxfmt .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "oxfmt --check . && oxlint && tsc --noEmit && vitest run"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "@types/node": "^26.2.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typebox": "^1.3.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "pi": {
    "extensions": [
      "./extensions/question.ts"
    ]
  }
}
